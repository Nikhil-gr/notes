# ==========================================
# TypeScript Compilation Outputs
# ==========================================
# Ignore the build directory where TS compiles JavaScript files
dist/
out/
build/
lib/

# Ignore TypeScript build info cache files
*.tsbuildinfo

# ==========================================
# Dependencies and Package Managers
# ==========================================
# Always ignore the heavy node_modules directory
node_modules/
jspm_packages/
typings/

# Optional: Un-comment if you do not want to lock versions
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ==========================================
# Environment Variables & Secrets
# ==========================================
# Never commit credentials or configuration files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ==========================================
# Logs and Runtime Data
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# ==========================================
# Testing Frameworks
# ==========================================
# Ignore coverage and test metrics output
coverage/
htmlcov/
.nyc_output/

# ==========================================
# IDEs and Text Editors
# ==========================================
# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json

# WebStorm / IntelliJ
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# Operating System Files
# ==========================================
# macOS configuration files
.DS_Store
.AppleDouble
.LSOverride

# Windows configuration files
Thumbs.db
Ehthumbs.db
Desktop.ini
